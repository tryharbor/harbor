# Copy to .env and fill in. Never commit real values. Setup guide: docs/setup/platform-apps.md
# With nothing set, Harbor runs fully offline: sandbox publishing + the simulated model, no keys needed.

# sandbox (default): every platform is simulated; posts never leave Harbor. live: the real X/LinkedIn/Instagram/Threads APIs.
HARBOR_PUBLISH_MODE=sandbox
# simulated (default): deterministic offline model, no spend. anthropic: the real model (switched off during the build-out).
HARBOR_MODEL=simulated

# Postgres. Unset = embedded PGlite under apps/api/.pglite (local dev). Set to a postgres:// URL (e.g. Supabase) in prod.
DATABASE_URL=

# Encrypts connected-account tokens. Generate with: openssl rand -base64 32
# Required in live mode. In sandbox mode an unset key falls back to a built-in dev key (fake tokens only).
HARBOR_SECRET_KEY=

# Public URL of the API. OAuth redirect URLs are built from it. Meta needs HTTPS: use a stable tunnel when developing.
HARBOR_API_URL=http://localhost:4800
# Where your own browser reaches the API (uploads, previews, starting a connection). Stays local even with a tunnel:
# without HARBOR_INTERNAL_TOKEN, requests through HARBOR_API_URL only reach OAuth callbacks, public media and /mcp.
# HARBOR_API_BROWSER_URL=http://localhost:4800
# Where the web app reaches the API from the server side (usually stays localhost).
HARBOR_API_INTERNAL_URL=http://localhost:4800
HARBOR_API_PORT=4800
HARBOR_WEB_URL=http://localhost:4801
# The workspace's timezone, e.g. America/Chicago: the app shows times in it, and the API uses it for best times,
# posting slots and schedule automations. Unset = the machine's own (set it on hosts, which run in UTC). The API reads
# HARBOR_TIMEZONE first, then this, so one line covers both when they share this file.
# NEXT_PUBLIC_HARBOR_TIMEZONE=
# Media library uploads and their crops. Unset = apps/api/.media (gitignored). Instagram and Threads download
# media from HARBOR_API_URL/media/…, so live posting with media needs a public HARBOR_API_URL.
# HARBOR_MEDIA_DIR=

# Hosting Harbor on the internet (docs/design/deploy-and-auth.md). Leave all of these unset on your own machine.
# The web app sends this token on every /v1 call, and the API refuses /v1 calls without it. Set the same random
# value on both. Generate with: openssl rand -base64 32
# HARBOR_INTERNAL_TOKEN=
# Sign in with GitHub. Setting GITHUB_CLIENT_ID turns sign-in on. The OAuth app's callback URL is
# HARBOR_WEB_URL/auth/github/callback.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Signs the session cookie (32+ characters): openssl rand -base64 32
# HARBOR_SESSION_SECRET=
# GitHub logins allowed to sign in, comma-separated.
# HARBOR_ALLOWED_GITHUB_USERS=

# Drafting / strategy model (only read when HARBOR_MODEL=anthropic)
ANTHROPIC_API_KEY=

# X (OAuth 2.0 confidential client)
X_CLIENT_ID=
X_CLIENT_SECRET=
# X bills every read. true = also read replies and import past posts (keep a spending limit on).
# HARBOR_X_READ_REPLIES=false

# LinkedIn (Share on LinkedIn + Sign In with LinkedIn using OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202601

# Instagram API with Instagram Login (the Instagram app id/secret, not the Meta app id)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Threads API
THREADS_APP_ID=
THREADS_APP_SECRET=
