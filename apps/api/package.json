{
  "name": "@harbor/api",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "mcp:stdio": "tsx --env-file-if-exists=../../.env src/cli/mcp-stdio.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:demo": "export DATABASE_URL=.pglite-demo HARBOR_PUBLISH_MODE=sandbox HARBOR_MODEL=simulated; tsx --env-file-if-exists=../../.env src/cli/seed-demo.ts && tsx --env-file-if-exists=../../.env src/server.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@harbor/ai": "workspace:*",
    "@harbor/core": "workspace:*",
    "@harbor/providers": "workspace:*",
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/sdk": "1.30.1",
    "hono": "4.13.9",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
